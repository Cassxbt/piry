    "piry:unwind": {
      "aliases": [],
      "args": {},
      "description": "Close a hedge before settlement: merge PIRY-L/PIRY-S pairs back into USDC, or sell PIRY-L on Kuru with a minimum-proceeds floor.",
      "examples": [
        "<%= config.bin %> piry unwind",
        "<%= config.bin %> piry unwind --claims 100 --method sell --min-proceeds 40"
      ],
      "flags": {
        "format": {
          "char": "f",
          "description": "Output format: text | json | toon (defaults to text in TTY, json when piped)",
          "name": "format",
