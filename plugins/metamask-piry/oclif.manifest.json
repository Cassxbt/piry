{
  "commands": {
    "piry:hedge": {
      "aliases": [],
      "args": {},
      "description": "Hedge GPU-hours by buying PIRY-L on Kuru within a spending cap. Previews unless --max-premium is given; every transaction goes through the Agent Wallet.",
      "examples": [
        "<%= config.bin %> piry hedge --gpu-hours 500",
        "<%= config.bin %> piry hedge --gpu-hours 500 --max-premium 150 --slippage 100",
        "<%= config.bin %> piry hedge --gpu-hours 500 --max-premium 1000 --allow-mint"
      ],
      "flags": {
        "format": {
          "char": "f",
          "description": "Output format: text | json | toon (defaults to text in TTY, json when piped)",
          "name": "format",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "text",
            "json",
            "toon"
          ],
          "type": "option"
        },
        "json": {
          "description": "Shorthand for --format=json",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        },
        "toon": {
          "description": "Shorthand for --format=toon",
          "name": "toon",
          "allowNo": false,
          "type": "boolean"
        },
        "verbose": {
          "char": "v",
          "description": "Show debug logs on stderr. Use this for troubleshooting",
          "name": "verbose",
          "allowNo": false,
          "type": "boolean"
        },
        "gpu-hours": {
          "description": "Total GPU-hours of compute to hedge",
          "name": "gpu-hours",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "max-premium": {
          "description": "Most USDC you will pay. Without it, nothing is sent and a preview is returned",
          "name": "max-premium",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "slippage": {
          "description": "Slippage tolerance in basis points (default 100 = 1%)",
          "name": "slippage",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "allow-mint": {
          "description": "If Kuru has no PIRY-L market, mint claim pairs instead (locks 1 USDC per claim)",
          "name": "allow-mint",
          "allowNo": false,
          "type": "boolean"
        },
        "short-to": {
          "description": "With --allow-mint: address that receives the PIRY-S leg",
          "name": "short-to",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "kuru-market": {
          "description": "Kuru order book for PIRY-L/USDC (defaults to PIRY_KURU_MARKET)",
          "name": "kuru-market",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "kuru-short-market": {
          "description": "Kuru order book for PIRY-S/USDC, used to sell the short leg when minting (defaults to PIRY_KURU_SHORT_MARKET)",
          "name": "kuru-short-market",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "piry:hedge",
      "pluginAlias": "mm-plugin-piry",
      "pluginName": "mm-plugin-piry",
      "pluginType": "core",
      "strict": true,
      "isESM": true,
      "relativePath": [
        "dist",
        "commands",
        "piry",
        "hedge.js"
      ]
    },
