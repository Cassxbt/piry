          "description": "Shorthand for --format=toon",
          "name": "toon",
          "allowNo": false,
          "type": "boolean"
        },
        "verbose": {
          "char": "v",
          "description": "Show debug logs on stderr. Use this for troubleshooting",
          "name": "verbose",
          "allowNo": false,
          "type": "boolean"
        },
        "claims": {
          "description": "PIRY-L claims to unwind (default: all held)",
          "name": "claims",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "method": {
          "description": "auto, merge or sell (default auto: merge pairs first, sell the rest on Kuru)",
          "name": "method",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "slippage": {
          "description": "Slippage tolerance in basis points for a Kuru sale (default 100)",
          "name": "slippage",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "min-proceeds": {
          "description": "Refuse to unwind for less than this many USDC in total (merge payout plus Kuru sale)",
